{
  "manifest_version": 3,
  "name": "Tervyn VPN",
  "short_name": "Tervyn",
  "version": "1.0.0",
  "description": "Free, account-free browser VPN: one click to the fastest verified server, or route only the sites you choose.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tervyn VPN",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "webRequest",
    "privacy",
    "contextMenus",
    "notifications",
    "activeTab",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-connection": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Connect or disconnect Tervyn VPN"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tervyn-vpn@tervyn.app",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
