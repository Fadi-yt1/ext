{
  "manifest_version": 3,
  "name": "Tervyn VPN",
  "short_name": "Tervyn",
  "version": "1.0.0",
  "description": "Free, account-free browser VPN: one click to the fastest verified server, or route only the sites you choose.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tervyn VPN",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "webRequest",
    "webRequestAuthProvider",
    "privacy",
    "contextMenus",
    "notifications",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-connection": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Connect or disconnect Tervyn VPN"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
